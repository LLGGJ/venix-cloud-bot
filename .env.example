// filepath: .env.example
# =============================================================================
# CONFIGURAÇÃO DO BOT VENIXCLOUD - MODELO DE VARIÁVEIS DE AMBIENTE
# =============================================================================
# Copie este arquivo para .env e preencha com seus dados reais.
# NUNCA commit o arquivo .env no Git.

# --- DISCORD ---
# Token do Bot obtido no Discord Developer Portal
DISCORD_TOKEN=seu_token_do_discord_aqui
# ID do Cliente (Application ID) do Discord
DISCORD_CLIENT_ID=seu_client_id_aqui

# --- MONGODB ---
# String de conexão com o MongoDB Atlas ou local
# Formato: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/venix_bot
MONGODB_DB_NAME=venix_bot

# --- VENIXCLOUD API ---
# URL base da API da VenixCloud (verifique a documentação oficial)
VENIX_API_BASE_URL=https://api.venixcloud.com/v1
# Client ID e Secret para OAuth2 (obtidos no painel da VenixCloud)
VENIX_OAUTH_CLIENT_ID=seu_client_id_venix
VENIX_OAUTH_CLIENT_SECRET=seu_client_secret_venix
# URL de redirecionamento para OAuth2 (deve bater com a configurada na VenixCloud)
VENIX_OAUTH_REDIRECT_URI=https://seu-site-vercel.app/callback

# --- SEGURANÇA ---
# Chave secreta para criptografia AES-256-GCM dos tokens salvos no DB
# Gere uma chave aleatória forte (ex: openssl rand -hex 32)
ENCRYPTION_KEY=sua_chave_secreta_de_32_bytes_em_hex_aqui

# --- OPICIONAL ---
# ID do canal de logs de erro (opcional)
ERROR_LOG_CHANNEL_ID=
# URL do site de suporte/login (conforme mencionado no README original)
SUPPORT_SITE_URL=https://seu-site-vercel.app
